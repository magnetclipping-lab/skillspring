# ─────────────────────────────────────────────────────────────────────────────
# SkillSpring environment variables. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.
# Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.in

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (Dashboard → Account & Settings → API Keys). Use rzp_test_ keys until go-live.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Dashboard → Webhooks → secret you set for https://<domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Email (Resend). Emails are recorded as "skipped" until these are set.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="SkillSpring <no-reply@yourdomain.in>"

# Video — Mux signed playback (Settings → Signing keys). Private key base64-encoded.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
# Optional: Mux API token for direct uploads from the course editor
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Video — Cloudflare Stream signed URLs (alternative to Mux). Private key base64-encoded.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_PRIVATE_KEY=

# Random string used to hash IPs for rate-limit keys
RATE_LIMIT_SALT=change-me-to-a-long-random-string
